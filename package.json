{
	"name": "monki-obsidian",
	"version": "1.0.0",
	"description": "An Obsidian plugin with a synchronized outline and quick checkbox editing shortcuts.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:zip": "npm run build && node package-plugin.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"outline",
		"checkbox"
	],
	"author": "Khanh Luong",
	"license": "0-BSD",
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"archiver": "^8.0.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
